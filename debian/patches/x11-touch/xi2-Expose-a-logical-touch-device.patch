 gdk/gdkseatdefaultprivate.h    |   5 +
 gdk/x11/gdkdevicemanager-xi2.c | 123 +++++++++++++++++++++--
 gdk/x11/gdkseat-xi2-private.h  |  29 ++++++
 gdk/x11/gdkseat-xi2.c          | 217 +++++++++++++++++++++++++++++++++++++++++
