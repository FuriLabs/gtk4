From: Alessandro Astone <alessandro.astone@canonical.com>
Date: Fri, 3 Apr 2026 10:40:58 +0200
Subject: application-wayland: Add NULL check on gtk_accessible_get_at_context

This may return NULL with GTK_A11Y=none

Forwarded: https://gitlab.gnome.org/GNOME/gtk/-/merge_requests/9756
---
 gtk/gtkapplication-wayland.c | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/gtk/gtkapplication-wayland.c b/gtk/gtkapplication-wayland.c
index e0cbd8e..407d80b 100644
--- a/gtk/gtkapplication-wayland.c
+++ b/gtk/gtkapplication-wayland.c
@@ -167,11 +167,14 @@ gtk_application_impl_wayland_handle_window_realize (GtkApplicationImpl *impl,
   g_free (id);
 
   at_context = gtk_accessible_get_at_context (GTK_ACCESSIBLE (window));
-  if (gtk_at_context_is_realized (at_context))
-    set_a11y_properties (window);
-  else
-    g_signal_connect_object (at_context, "notify::realized", (GCallback) set_a11y_properties, window, G_CONNECT_SWAPPED);
-  g_clear_object (&at_context);
+  if (at_context)
+    {
+      if (gtk_at_context_is_realized (at_context))
+        set_a11y_properties (window);
+      else
+        g_signal_connect_object (at_context, "notify::realized", (GCallback) set_a11y_properties, window, G_CONNECT_SWAPPED);
+      g_clear_object (&at_context);
+    }
 
   impl_class->handle_window_realize (impl, window);
 }
