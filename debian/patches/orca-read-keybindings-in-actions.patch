+                                                 G_IO_ERROR,
+                                                 G_IO_ERROR_INVALID_ARGUMENT,
+                                                 "Unknown action %d",
+                                                 idx);
+        }
     }
   else if (g_strcmp0 (method_name, "GetActions") == 0)
